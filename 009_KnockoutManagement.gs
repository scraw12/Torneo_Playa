/** Admin-only management of ELIMINATORIAS; other phases and history are untouched. */
function adminGetKnockoutManagementData(){requireAdmin();updateKnockoutPlayerCounts_();const data=getPublicTournamentData(),counts=getKnockoutPlayerCounts_();data.players=getPlayers().map(name=>({name:name,matches:counts[String(name).trim().toLowerCase()]||0}));return data;}
function adminAddKnockoutPlayer(playerName){requireAdmin();const name=String(playerName||'').trim();if(!name)throw new Error('Escribe el nombre del jugador.');const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.PLAYERS);if(!sh)throw new Error('No existe la hoja JUGADORES.');const last=sh.getLastRow(),rows=last>=2?sh.getRange(2,1,last-1,2).getValues():[],index=rows.findIndex(r=>String(r[0]||'').trim().toLowerCase()===name.toLowerCase());if(index>=0)sh.getRange(index+2,2).setValue(true);else sh.getRange(Math.max(2,last+1),1,1,2).setValues([[name,true]]);updateKnockoutPlayerCounts_();return adminGetKnockoutManagementData();}
function adminSaveKnockoutMatch(match){requireAdmin();if(!match||typeof match!=='object')throw new Error('Datos del partido no válidos.');const competition=String(match.competition||'').trim().toUpperCase(),round=String(match.round||'').trim(),pair1=String(match.pair1||'').trim(),pair2=String(match.pair2||'').trim(),id=String(match.id||'').trim();if(competition!=='ORO'&&competition!=='PLATA')throw new Error('La competición debe ser ORO o PLATA.');if(!round||!pair1||!pair2)throw new Error('Indica la ronda y las dos parejas.');if(pair1===pair2)throw new Error('Las dos parejas no pueden ser iguales.');const names=getTeamPlayerNames_(pair1).concat(getTeamPlayerNames_(pair2));if(new Set(names.map(n=>n.toLowerCase())).size!==names.length)throw new Error('Un jugador no puede aparecer dos veces en el mismo partido.');const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.KNOCKOUT);if(!sh)throw new Error('No existe la hoja ELIMINATORIAS.');const last=sh.getLastRow(),rows=last>=2?sh.getRange(2,1,last-1,8).getValues():[],rowIndex=id?rows.findIndex(r=>String(r[2]).trim()===id):-1;if(id&&rowIndex<0)throw new Error('No se ha encontrado el partido que quieres editar.');if(rowIndex>=0){const old=rows[rowIndex],changed=String(old[3]||'').trim()!==pair1||String(old[4]||'').trim()!==pair2;sh.getRange(rowIndex+2,1,1,8).setValues([[competition,round,id,pair1,pair2,changed?'':old[5],changed?'':old[6],changed?'':old[7]]]);if(changed)invalidateKnockoutDependents_(id,{});}else{const ids=rows.map(r=>String(r[2]||'').trim());let n=1,newId;do{newId='MAN-'+String(n).padStart(3,'0');n++;}while(ids.includes(newId));sh.getRange(Math.max(2,last+1),1,1,8).setValues([[competition,round,newId,pair1,pair2,'','','']]);}updateKnockoutPlayerCounts_();return adminGetKnockoutManagementData();}
function adminDeleteKnockoutMatch(matchId){requireAdmin();const id=String(matchId||'').trim(),sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.KNOCKOUT);if(!id)throw new Error('Partido no válido.');if(!sh||sh.getLastRow()<2)throw new Error('No hay eliminatorias generadas.');const rows=sh.getRange(2,1,sh.getLastRow()-1,8).getValues(),index=rows.findIndex(r=>String(r[2]).trim()===id);if(index<0)throw new Error('No se ha encontrado ese partido.');invalidateKnockoutDependents_(id,{});sh.deleteRow(index+2);updateKnockoutPlayerCounts_();return adminGetKnockoutManagementData();}
function getTeamPlayerNames_(team){return String(team||'').split(/\s*\/\s*/).map(s=>String(s||'').trim()).filter(s=>s&&!/^PENDIENTE$/i.test(s)&&!/^Ganador\s+/i.test(s));}
function invalidateKnockoutDependents_(matchId,visited){const token='Ganador '+String(matchId||'').trim();if(visited[token])return;visited[token]=true;const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.KNOCKOUT);if(!sh||sh.getLastRow()<2)return;const rows=sh.getRange(2,1,sh.getLastRow()-1,8).getValues();rows.forEach((row,i)=>{let changed=false;[3,4].forEach(col=>{if(String(row[col]||'').trim()===token){sh.getRange(i+2,col+1).setValue('PENDIENTE');changed=true;}});if(changed){sh.getRange(i+2,6,1,3).clearContent();invalidateKnockoutDependents_(String(row[2]),visited);}});}
function getKnockoutPlayerCounts_(){const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.KNOCKOUT),counts={};if(!sh||sh.getLastRow()<2)return counts;sh.getRange(2,1,sh.getLastRow()-1,8).getValues().forEach(row=>{new Set(getTeamPlayerNames_(row[3]).concat(getTeamPlayerNames_(row[4]))).forEach(name=>{const key=name.toLowerCase();counts[key]=(counts[key]||0)+1;});});return counts;}
function updateKnockoutPlayerCounts_(){const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.PLAYERS);if(!sh)throw new Error('No existe la hoja JUGADORES.');const header=String(sh.getRange(1,3).getValue()||'').trim();if(!header)sh.getRange(1,3).setValue('Partidos');else if(header.toLowerCase()!=='partidos')throw new Error('La columna C de JUGADORES debe tener la cabecera "Partidos".');const last=sh.getLastRow();if(last<2)return;const counts=getKnockoutPlayerCounts_(),names=sh.getRange(2,1,last-1,1).getValues();sh.getRange(2,3,names.length,1).setValues(names.map(r=>{const key=String(r[0]||'').trim().toLowerCase();return [key?(counts[key]||0):''];}));}
